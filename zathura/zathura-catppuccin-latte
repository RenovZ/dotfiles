set window-title-basename "true"
set selection-clipboard "clipboard"

#
# Catppuccin Latte color theme for Zathura
#

set notification-error-bg       "#d20f39" # red
set notification-error-fg       "#eff1f5" # base
set notification-warning-bg     "#df8e1d" # yellow
set notification-warning-fg     "#eff1f5" # base
set notification-bg             "#eff1f5" # base
set notification-fg             "#4c4f69" # text

set completion-bg               "#ccd0da" # surface0
set completion-fg               "#4c4f69" # text
set completion-group-bg         "#e6e9ef" # mantle
set completion-group-fg         "#5c5f77" # subtext1
set completion-highlight-bg     "#acb0be" # surface2
set completion-highlight-fg     "#4c4f69" # text

set index-bg                    "#ccd0da" # surface0
set index-fg                    "#4c4f69" # text
set index-active-bg             "#acb0be" # surface2
set index-active-fg             "#4c4f69" # text

set inputbar-bg                 "#eff1f5" # base
set inputbar-fg                 "#4c4f69" # text
set statusbar-bg                "#ccd0da" # surface0
set statusbar-fg                "#4c4f69" # text

set highlight-color             "#df8e1d" # yellow
set highlight-active-color      "#ea76cb" # pink

set default-bg                  "#eff1f5" # base
set default-fg                  "#4c4f69" # text

set render-loading              true
set render-loading-fg           "#eff1f5" # base
set render-loading-bg           "#4c4f69" # text

#
# Recolor mode settings
#

set recolor-lightcolor          "#eff1f5" # base
set recolor-darkcolor           "#4c4f69" # text

#
# Startup options
#
set adjust-open width
set recolor true
