#!/bin/sh

file="$1"
w="${2:-0}"
h="${3:-0}"
x="${4:-0}"
y="${5:-0}"

[ -z "$file" ] && exit 0

# If it's a directory, list contents (with git status when applicable)
if [ -d "$file" ]; then
	if git -C "$file" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		eza -agl --git --color=always --icons=always "$file" 2>/dev/null
	elif git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
		eza -agl --git --color=always --icons=always "$file" 2>/dev/null
	else
		eza -agl --color=always --icons=always "$file" 2>/dev/null
	fi || ls -agl --color=always "$file" 2>/dev/null || ls -agl "$file"
	exit 0
fi

# Temporary file cleanup
tmp_files=""
cleanup() {
	[ -n "$tmp_files" ] && rm -f $tmp_files
}
trap cleanup EXIT

# Detect a non-UTF-8 encoding for a file; print an iconv-compatible name,
# or nothing when the file is UTF-8/ASCII or detection is unreliable.
detect_encoding() {
	f="$1"

	# Fast path: file(1) reliably recognizes UTF-8/ASCII and explicit UTF-16/32
	fenc=$(file -b --mime-encoding "$f" 2>/dev/null)
	case "$fenc" in
		utf-8|utf-8-with-bom|us-ascii|ascii) return 0 ;;
		utf-16le|utf-16be|utf-32le|utf-32be)
			printf '%s' "$fenc"
			return 0
			;;
	esac

	if command -v chardet >/dev/null 2>&1; then
		# Sample only the head: chardet slows down on large files
		res=$(head -c 262144 "$f" 2>/dev/null | chardet 2>/dev/null | head -n 1)
		conf=${res##* }
		# Require a numeric confidence so "no result" lines are filtered out
		case "$conf" in
			''|*[!0-9.]*) return 0 ;;
		esac
		# Weak guesses lead to wrong conversions, which look worse than raw bytes
		[ "$(awk -v c="$conf" 'BEGIN { print (c + 0 >= 0.6) ? 1 : 0 }')" = 1 ] || return 0
		enc=${res#*: }
		enc=${enc%% *}
		case "$enc" in
			''|utf-8|utf-8-sig|ascii|None|unknown) return 0 ;;
			# GB2312 is a strict subset of GBK/GB18030; decode with the widest
			GB2312|gb2312) enc=GB18030 ;;
			MacRoman|macroman) enc=MACINTOSH ;;
		esac
		printf '%s' "$enc"
	else
		case "$fenc" in
			''|binary|unknown|unknown-8bit) return 0 ;;
		esac
		printf '%s' "$fenc"
	fi
}

# Set $utf8_file to a UTF-8 temp copy of $1 for non-UTF-8 text files,
# or to $1 itself when the file is already UTF-8 (or cannot be converted).
to_utf8() {
	utf8_file="$1"
	enc=$(detect_encoding "$1")
	[ -z "$enc" ] && return 0
	command -v iconv >/dev/null 2>&1 || return 0
	base=${1##*/}
	case "$base" in
		*.*) ext=".${base##*.}" ;;
		*) ext="" ;;
	esac
	tmp=$(mktemp "/tmp/lf-utf8-XXXXXX${ext}" 2>/dev/null) || return 0
	# -c drops bytes iconv cannot map so one bad byte cannot hide the rest
	if iconv -c -f "$enc" -t UTF-8 "$1" >"$tmp" 2>/dev/null; then
		tmp_files="$tmp_files $tmp"
		utf8_file="$tmp"
	else
		rm -f "$tmp"
	fi
}

# Text preview with git gutter (dirty files) or bat (clean files)
text_preview() {
	# Split leading bat flags (e.g. --language=cpp) from the file argument;
	# without a file argument the content is read from stdin (e.g. CSV pipes)
	flags=""
	while [ $# -gt 0 ]; do
		case "$1" in
			--*|-*) flags="$flags $1"; shift ;;
			*) break ;;
		esac
	done
	src="${1:-}"

	# Git gutter: tracked, modified files get per-line markers (like editors)
	if [ -z "$flags" ] && [ -n "$src" ] && [ -f "$src" ] \
		&& git rev-parse --git-dir >/dev/null 2>&1 \
		&& git ls-files --error-unmatch "$src" >/dev/null 2>&1 \
		&& ! git diff --quiet HEAD -- "$src" 2>/dev/null \
		&& command -v delta >/dev/null 2>&1; then
		dt="--dark"
		[ "$(darklight 2>/dev/null)" = "Light" ] && dt="--light"
		enc=$(detect_encoding "$src")
		if [ -n "$enc" ] && iconv -f "$enc" -t UTF-8 </dev/null >/dev/null 2>&1; then
			git diff -U99999 HEAD -- "$src" 2>/dev/null | iconv -c -f "$enc" -t UTF-8 | \
				delta $dt --features 'line-numbers decorations' --file-style=omit --hunk-header-style=omit --paging=never --width="${w:-80}" 2>/dev/null | \
				tail -n +2
		else
			git diff -U99999 HEAD -- "$src" 2>/dev/null | \
				delta $dt --features 'line-numbers decorations' --file-style=omit --hunk-header-style=omit --paging=never --width="${w:-80}" 2>/dev/null | \
				tail -n +2
		fi
		return
	fi

	# Non-UTF-8 text must be converted or the terminal renders mojibake
	if [ -n "$src" ] && [ -f "$src" ]; then
		to_utf8 "$src"
		src="$utf8_file"
	fi

	# Fallback: normal bat / cat preview (preserving flags like --language=...)
	if command -v bat >/dev/null 2>&1; then
		style="plain"
		[ -n "$LF_LINE_NUMBERS" ] && style="numbers"
		if [ -n "$src" ]; then
			bat --color=always --style="$style" --pager=never $flags "$src"
		else
			bat --color=always --style="$style" --pager=never $flags
		fi
	elif [ -n "$src" ]; then
		cat "$src"
	else
		cat
	fi
}

# Image preview with terminal graphics protocol support
image_preview() {
	img="$1"

	if command -v chafa >/dev/null 2>&1; then
		chafa -f kitty -s "${w}x${h}" "$img" 2>/dev/null
		return
	fi

	if command -v viu >/dev/null 2>&1; then
		viu -b "$img" 2>/dev/null
		return
	fi

	if command -v catimg >/dev/null 2>&1; then
		catimg -w "${w}" "$img"
	else
		echo "No image previewer available. Install chafa."
		file -b "$img"
	fi
}

# Lowercase filename for case-insensitive matching
lc_file=$(printf '%s' "$file" | tr '[:upper:]' '[:lower:]')

case "$lc_file" in
	*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz2|*.tar.xz|*.txz|*.tar.zst)
		tar tf "$file" 2>/dev/null || echo "Cannot list archive contents"
		;;
	*.zip|*.jar|*.war|*.ear|*.oxt|*.apk|*.ipa)
		unzip -l "$file" 2>/dev/null || echo "Cannot list zip contents"
		;;
	*.rar)
		unrar l "$file" 2>/dev/null || echo "Install unrar to preview RAR files"
		;;
	*.7z)
		7z l "$file" 2>/dev/null || echo "Install p7zip to preview 7z files"
		;;
	*.md)
		if command -v glow >/dev/null 2>&1; then
			to_utf8 "$file"
			if command -v darklight >/dev/null 2>&1; then
				theme=$(darklight 2>/dev/null | tr '[:upper:]' '[:lower:]')
				[ -z "$theme" ] && theme="dark"
				CLICOLOR_FORCE=1 glow -s "$theme" "$utf8_file"
			else
				CLICOLOR_FORCE=1 glow "$utf8_file"
			fi
		else
			text_preview "$file"
		fi
		;;
	*.pdf)
		if command -v pdftoppm >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-pdf-XXXXXX).jpg
			tmp_files="$tmp_files $tmp"
			if pdftoppm -jpeg -f 1 -singlefile "$file" "${tmp%.jpg}" 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to render PDF preview"
			fi
		else
			echo "PDF preview requires poppler-utils (pdftoppm)"
		fi
		;;
	*.epub)
		if command -v epub-thumbnailer >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-epub-XXXXXX).jpg
			tmp_files="$tmp_files $tmp"
			if epub-thumbnailer "$file" "$tmp" 1024 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to render EPUB preview"
			fi
		else
			echo "Install epub-thumbnailer for EPUB preview"
		fi
		;;
	*.cbz|*.cbr|*.cbt)
		if command -v comicthumb >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-comic-XXXXXX).jpg
			tmp_files="$tmp_files $tmp"
			if comicthumb "$file" "$tmp" 1024 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to render comic preview"
			fi
		else
			echo "Install comicthumb for comic preview"
		fi
		;;
	*.avi|*.mp4|*.wmv|*.dat|*.3gp|*.ogv|*.mkv|*.mpg|*.mpeg|*.vob|*.flv|*.mov|*.webm|*.mts|*.m4v|*.qt|*.divx|*.asf|*.rm|*.rmvb)
		if command -v ffmpegthumbnailer >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-video-XXXXXX).jpg
			tmp_files="$tmp_files $tmp"
			if ffmpegthumbnailer -i "$file" -o "$tmp" -s 0 -q 5 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to generate video thumbnail"
			fi
		elif command -v ffmpeg >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-video-XXXXXX).jpg
			tmp_files="$tmp_files $tmp"
			if ffmpeg -i "$file" -ss 00:00:01 -vframes 1 "$tmp" -y 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to generate video thumbnail"
			fi
		else
			echo "Video preview requires ffmpegthumbnailer or ffmpeg"
		fi
		;;
	*.bmp|*.jpg|*.jpeg|*.png|*.xpm|*.webp|*.gif|*.jfif|*.ico|*.tiff|*.tif|*.heic|*.avif)
		image_preview "$file"
		;;
	*.svg)
		if command -v convert >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-svg-XXXXXX).png
			tmp_files="$tmp_files $tmp"
			if convert "$file" "$tmp" 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to convert SVG"
			fi
		elif command -v rsvg-convert >/dev/null 2>&1; then
			tmp=$(mktemp /tmp/lf-svg-XXXXXX).png
			tmp_files="$tmp_files $tmp"
			if rsvg-convert "$file" -o "$tmp" 2>/dev/null; then
				image_preview "$tmp"
			else
				echo "Failed to convert SVG"
			fi
		else
			text_preview "$file"
		fi
		;;
	*.wav|*.mp3|*.flac|*.m4a|*.wma|*.ape|*.ac3|*.ogg|*.oga|*.ogx|*.spx|*.opus|*.asf|*.mka|*.aac|*.wma|*.dsd|*.dff|*.dsf)
		if command -v exiftool >/dev/null 2>&1; then
			exiftool "$file"
		elif command -v id3v2 >/dev/null 2>&1; then
			id3v2 -l "$file"
		else
			file -b "$file"
		fi
		;;
	*.doc)
		catdoc "$file" 2>/dev/null || text_preview "$file"
		;;
	*.docx)
		if command -v docx2txt >/dev/null 2>&1; then
			docx2txt "$file" - 2>/dev/null
		else
			text_preview "$file"
		fi
		;;
	*.odt|*.ods|*.odp|*.sxw)
		odt2txt "$file" 2>/dev/null || text_preview "$file"
		;;
	*.xls|*.xlsx|*.csv)
		if command -v ssconvert >/dev/null 2>&1; then
			ssconvert --export-type=Gnumeric_stf:stf_csv "$file" "fd://1" 2>/dev/null | text_preview --language=csv
		elif command -v xlsx2csv >/dev/null 2>&1; then
			xlsx2csv "$file" 2>/dev/null | text_preview --language=csv
		else
			text_preview "$file"
		fi
		;;
	*.html|*.htm|*.xml|*.xhtml)
		if command -v w3m >/dev/null 2>&1; then
			w3m -dump "$file"
		elif command -v lynx >/dev/null 2>&1; then
			lynx -dump "$file"
		elif command -v html2text >/dev/null 2>&1; then
			html2text "$file" 2>/dev/null
		else
			text_preview "$file"
		fi
		;;
	*.[1-8])
		if [ "$(file -b --mime-type "$file" 2>/dev/null)" = "text/troff" ]; then
			man "$file" | col -b
		else
			text_preview "$file"
		fi
		;;
	*.o|*.obj)
		nm "$file" 2>/dev/null || file -b "$file"
		;;
	*.torrent)
		transmission-show "$file" 2>/dev/null || file -b "$file"
		;;
	*.iso)
		iso-info --no-header -l "$file" 2>/dev/null || file -b "$file"
		;;
	*.ino|*.pde)
		text_preview --language=cpp "$file"
		;;
	*)
		# Detect binary vs text via MIME type
		mime=$(file -b --mime-type "$file" 2>/dev/null)
		case "$mime" in
			text/*|application/json|application/xml|application/javascript|application/x-ndjson|application/x-yaml|application/toml)
				text_preview "$file"
				;;
			*)
				file -b "$file"
				;;
		esac
		;;
esac

exit 0
