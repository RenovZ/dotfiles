#!/bin/sh

# Remove ueberzug preview if active
[ -p "$FIFO_UEBERZUGPP" ] && printf '{"action":"remove","identifier":"preview"}\n' >"$FIFO_UEBERZUGPP"

# Clear Kitty graphics protocol images (Kitty, Ghostty, etc.)
kitty_gfx_supported() {
	[ -n "$KITTY_WINDOW_ID" ] && return 0
	[ "$TERM_PROGRAM" = "ghostty" ] && return 0
	[ "$TERM" = "xterm-ghostty" ] && return 0
	return 1
}

if kitty_gfx_supported; then
	if command -v kitten >/dev/null 2>&1; then
		kitten icat --clear --silent > /dev/tty 2>/dev/null
	elif command -v kitty >/dev/null 2>&1; then
		kitty +icat --clear --silent > /dev/tty 2>/dev/null
	fi
fi
