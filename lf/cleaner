#!/bin/sh

# Remove ueberzug preview if active
[ -p "$FIFO_UEBERZUG" ] && printf '{"action":"remove","identifier":"preview"}\n' >"$FIFO_UEBERZUG"

# Clear Kitty terminal images if in Kitty
if [ -n "$KITTY_WINDOW_ID" ]; then
	if command -v kitten >/dev/null 2>&1; then
		kitten icat --clear --silent 2>/dev/null
	elif command -v kitty >/dev/null 2>&1; then
		kitty +icat --clear --silent 2>/dev/null
	fi
fi
