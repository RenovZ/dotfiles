#set shell bash
#set shellopts '-eu'
#set ifs "\n"
set scrolloff 10
set rulerfile ~/.config/lf/ruler.custom

set ratios 1:2:3
set icons true

set previewer ~/.config/lf/preview
set cleaner ~/.config/lf/cleaner

# trash-cli
cmd trash %trash-put -- $fx

# node.js
cmd node_script ${{
    script="$(jq -r '.scripts | keys[]' <package.json | sort | fzf --height 20%)"
    npm run "$script"
}}

# zoxide
cmd z %{{
    result="$(zoxide query --exclude "$PWD" "$@" | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

cmd zi ${{
    result="$(zoxide query -i | sed 's/\\/\\\\/g;s/"/\\"/g')"
    lf -remote "send $id cd \"$result\""
}}

# show git repo info on cd, file stats on select
cmd on-cd &{{ ~/.config/lf/on_cd.sh }}
cmd on-select &{{ ~/.config/lf/on_select.sh }}

# git
cmd git_repo_info ${{
    ~/.config/lf/git_repo_info.sh || true
}}

cmd git_add ${{clear;git-forgit add}}
cmd git_push ${{
    ~/.config/lf/git_push.sh || true
}}
cmd git_diff ${{clear;git-forgit diff}}
cmd git_pull ${{
    ~/.config/lf/git_pull.sh || true
}}
cmd git_status ${{clear; git -c color.status=always status | less -R}}
cmd git_reset_head ${{clear;git-forgit reset_head}}
cmd git_log ${{clear;FORGIT_LOG_GRAPH_ENABLE=false git-forgit log}}
cmd git_remote ${{clear; git remote -v | less -R}}
cmd git_checkout_branch ${{clear;git-forgit checkout_branch}}
cmd git_branch_delete ${{clear;git-forgit branch_delete}}
cmd git_checkout_tag ${{clear;git-forgit checkout_tag}}
cmd git_checkout_commit ${{clear;git-forgit checkout_commit}}
cmd git_checkout_file ${{clear;git-forgit checkout_file}}
cmd git_blame ${{clear;git-forgit blame}}
cmd git_stash_show ${{clear;git-forgit stash_show}}
cmd git_commit ${{
    clear
    git commit "$@"
}}
cmd git_fixup ${{clear;git-forgit fixup}}
cmd git_cherry_pick ${{clear;git-forgit cherry_pick}}
cmd git_ignore ${{clear;git-forgit ignore}}
cmd git_show ${{clear;git-forgit show}}

# Interactive changed-files browser — like the VSCode/Zed git panel
cmd git_changes ${{
    ~/.config/lf/git_changes.sh || true
}}
cmd git_diffstat ${{
    ~/.config/lf/git_diffstat.sh || true
}}

map gso :git_show
map ga :git_add
map gp :git_push
map gd :git_diff
map gu :git_pull
map gl :git_log
map ge push %git<space>
map gi :git_ignore
map gce :git_commit
map gbd :git_branch_delete
map gcb :git_checkout_branch
map gct :git_checkout_tag
map gcc :git_checkout_commit
map gcp :git_cherry_pick
map gcf :git_checkout_file
map gbl :git_blame
map gst :git_status
map gss :git_stash_show
map gfu :git_fixup
map grv :git_remote
map grh :git_reset_head
map gI :git_repo_info
map gc :git_changes
map gds :git_diffstat
# Full file with per-line git gutter (unified view, like editor)
# --paging=always gives delta direct TTY access so it auto-detects terminal background
map gD $git diff -U99999 HEAD -- $f | delta --features 'line-numbers decorations' --paging=always
# Compact diff with delta syntax highlighting
map gC $git diff HEAD -- $f | delta --features 'line-numbers decorations' --paging=always

# fzf
cmd fzf $$EDITOR $(find . -name "$1" | fzf)
cmd fzf_jump ${{
    ~/.config/lf/fzf_jump.sh || true
}}
cmd rg_search ${{
    ~/.config/lf/rg_search.sh || true
}}
cmd fd_search ${{
    ~/.config/lf/fd_search.sh || true
}}
cmd fdh_search ${{
    ~/.config/lf/fd_search.sh --hidden || true
}}
cmd fdi_search ${{
    ~/.config/lf/fd_search.sh --no-ignore || true
}}
cmd fda_search ${{
    ~/.config/lf/fd_search.sh --hidden --no-ignore || true
}}
cmd fzf_raw ${{
    # preview="bat --color=always --style=numbers --line-range=:500 {}"
    fzf
}}

cmd fzf_search ${{
    ~/.config/lf/fzf_search.sh || true
}}

map f
map fg :fzf_search
map fj :fzf_jump
map fs :rg_search
map fd :fd_search
map fh :fdh_search
map fi :fdi_search
map fa :fda_search
map fe $$EDITOR $(fzf)
map fw :fzf_raw
map ff push :fzf<space>

map . set hidden!

#create new directory or file
map o
cmd mkdir %mkdir "$@"
map od push %mkdir<space>
cmd touch %touch "$@"
map of push %touch<space>

#delete file or directories
map x
map x push :delete<enter>

map i $LF_LINE_NUMBERS=1 ~/.config/lf/preview $f | ov
