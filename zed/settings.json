// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "edit_predictions": {
    "provider": "zed"
  },
  "vim_mode": false,
  "agent": {
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-5-mini"
    }
  },
  "language_models": {
    "ollama": {
      "api_url": "http://localhost:11434",
      "available_models": [
        {
          "name": "gpt-oss:120b-cloud",
          "display_name": "gpt-oss:120b-cloud (65GB) 128K",
          "max_tokens": 131072,
        },
        {
          "name": "gpt-oss:latest",
          "display_name": "gpt-oss:latest (14GB) 128K",
          "max_tokens": 131072,
        },
        {
          "name": "deepseek-v3.1:671b-cloud",
          "display_name": "deepseek-v3.1:671b-cloud (404GB) 160K",
          "max_tokens": 163840,
        },
        {
          "name": "qwen3-coder:480b-cloud",
          "display_name": "qwen3-coder:480b-cloud (290GB) 256K",
          "max_tokens": 262144,
        }
      ]
    }
  },
  // "format_on_save": "language_server",
  "agent_buffer_font_size": 16.0,
  "agent_ui_font_size": 16.0,
  "collaboration_panel": {
    "button": true
  },
  "notification_panel": {
    "button": true
  },
  "debugger": {
    "timeout": 2000,
    "dock": "bottom"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "helix_mode": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  // "vim_mode": true,
  "preferred_line_length": 120,
  "soft_wrap": "preferred_line_length",
  "theme": {
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16.0,
  "ui_font_family": "Monaco",
  "ui_font_weight": 400,
  "buffer_font_size": 16,
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_weight": 400,
  "buffer_line_height": {
    "custom": 1.4
  },
  "minimap": {
    "max_width_columns": 80,
    "display_in": "active_editor",
    "show": "auto",
    "thumb": "hover",
    "thumb_border": "none",
    "current_line_highlight": "all"
  },
  "terminal": {
    "dock": "bottom",
    "font_size": 14,
    "font_family": "Hack Nerd Font Mono",
    "line_height": "standard",
    "font_weight": 600
  },
  "inlay_hints": {
    "show_background": false,
    "show_type_hints": true,
    "enabled": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "show_other_hints": true,
    "show_parameter_hints": true
  },
  "formatter": [
    { "language_server": { "name": "svelte-language-server" } },
    { "language_server": { "name": "gopls" } },
    {
      "language_server": {
        "name": "rust-analyzer"
      }
    },
    {
      "external": {
        "command": "sed",
        "arguments": ["-e", "s/ *$//"]
      }
    }
  ],
  "languages": {
    "Python": {
      "language_servers": [
        "basedpyright",
        // disable the other python language servers
        "!pyright",
        "!pylsp"
      ]
    }
  },
  "lsp": {
    "gopls": {
      "initialization_options": {
        "hints": {
          "assignVariableTypes": false,
          "compositeLiteralFields": false,
          "compositeLiteralTypes": false,
          "constantValues": false,
          "functionTypeParameters": false,
          "parameterNames": false,
          "rangeVariableTypes": false
        }
      }
    },
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "references": {
          "excludeImports": true
        },
        "check": {
          "command": "clippy" // rust-analyzer.check.command (default: "check")
        }
      }
    },
    "clangd": {
      "binary": {
        // "path": "C:/Program Files/LLVM/bin/clangd.exe",
        "arguments": [
          "--function-arg-placeholders=1",
          "--background-index", // 启用全局索引，加快代码跳转速度
          "--compile-commands-dir=.", // 指定编译数据库（如果有 compile_commands.json）
          "--clang-tidy", // 启用 Clang-Tidy
          "--cross-file-rename", // 支持跨文件重命名
          "--completion-style=detailed"
        ]
      }
    }
  }
}
