// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  // "format_on_save": "language_server",
  "collaboration_panel": {
    "button": true
  },
  "notification_panel": {
    "button": true
  },
  "debugger": {
    "timeout": 2000,
    "dock": "right"
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false
  },
  "tabs": {
    "close_position": "right",
    "file_icons": false,
    "git_status": false
  },
  "title_bar": {
    "show_menus": false,
    "show_branch_icon": true
  },
  "outline_panel": {
    "dock": "right"
  },
  "helix_mode": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "agent": {
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4.1"
    }
  },
  "features": {
    "edit_prediction_provider": "zed"
  },
  // "vim_mode": true,
  "preferred_line_length": 160,
  "soft_wrap": "preferred_line_length",
  "theme": {
    "light": "One Light",
    "dark": "One Dark"
  },
  "ui_font_size": 16,
  "ui_font_family": "Monaco",
  "ui_font_weight": 400,
  "buffer_font_size": 16,
  "buffer_font_family": "Hack Nerd Font",
  "buffer_font_weight": 400,
  "buffer_line_height": {
    "custom": 1.4
  },
  "minimap": {
    "max_width_columns": 80,
    "display_in": "active_editor",
    "show": "auto",
    "thumb": "hover",
    "thumb_border": "none",
    "current_line_highlight": "all"
  },
  "terminal": {
    "dock": "bottom",
    "font_size": 14,
    "font_family": "Hack Nerd Font Mono",
    "line_height": "standard",
    "font_weight": 600
  },
  "inlay_hints": {
    "show_background": false,
    "show_type_hints": true,
    "enabled": true,
    "edit_debounce_ms": 700,
    "scroll_debounce_ms": 50,
    "show_other_hints": true,
    "show_parameter_hints": true
  },
  "formatter": [
    {
      "language_server": {
        "name": "rust-analyzer"
      }
    },
    {
      "external": {
        "command": "sed",
        "arguments": ["-e", "s/ *$//"]
      }
    }
  ],
  "languages": {
    "Python": {
      "language_servers": [
        "basedpyright",
        // disable the other python language servers
        "!pyright",
        "!pylsp"
      ]
    }
  },
  "lsp": {
    "rust-analyzer": {
      "enable_lsp_tasks": true,
      "initialization_options": {
        "check": {
          "command": "clippy" // rust-analyzer.check.command (default: "check")
        }
      }
    },
    "clangd": {
      "binary": {
        // "path": "C:/Program Files/LLVM/bin/clangd.exe",
        "arguments": [
          "--function-arg-placeholders=1",
          "--background-index", // 启用全局索引，加快代码跳转速度
          "--compile-commands-dir=.", // 指定编译数据库（如果有 compile_commands.json）
          "--clang-tidy", // 启用 Clang-Tidy
          "--cross-file-rename", // 支持跨文件重命名
          "--completion-style=detailed"
        ]
      }
    }
  }
}
