font-family = "Hack Nerd Font Mono"
# font-style = regular
font-size = 12

# window-padding-x = 4
background-opacity = 0.85
background-blur = true

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,sudo,title

# Keep the native title bar (draggable) with its height flattened by narrow.css;
# merging into the tabs style would lose the title bar drag area
gtk-titlebar-style = tabs
gtk-custom-css = ~/.config/ghostty/narrow.css

# theme = dark:Ubuntu,light:Atom One Light
# theme = Ubuntu
theme = Catppuccin Latte

# Selecting text copies it to both PRIMARY and the system clipboard
copy-on-select = clipboard

config-file = ?auto/theme.ghostty

keybind = cmd+enter=toggle_fullscreen
keybind = cmd+ctrl+f=toggle_fullscreen
keybind = ctrl+enter=unbind

# Super+Shift+[ / ]: previous / next tab
keybind = super+shift+[=previous_tab
keybind = super+shift+]=next_tab
